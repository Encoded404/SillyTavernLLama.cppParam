{
    "name": "sillytavern-llamacpp-samplers",
    "version": "1.0.0",
    "private": true,
    "description": "SillyTavern extension that exposes llama.cpp's full sampler set on the Custom (OpenAI-compatible) endpoint",
    "type": "module",
    "main": "server-plugin.mjs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Encoded404/SillyTavernLLama.cppParam.git"
    },
    "keywords": [
        "sillytavern",
        "sillytavern-extension",
        "llama.cpp",
        "sampling",
        "dry",
        "top-k",
        "min-p"
    ],
    "scripts": {
